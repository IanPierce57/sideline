# A blank copy of the key file. Real keys go in .env (never shared), saved with set_key.sh:
#   ./set_key.sh          Anthropic (Claude) key, required
#   ./set_key.sh google   Google Cloud Text-to-Speech key, optional (voices)
#   ./set_key.sh gnews    GNews key, optional (news ticker)
ANTHROPIC_API_KEY=
GOOGLE_TTS_KEY=
GNEWS_API_KEY=
